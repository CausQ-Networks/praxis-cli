<?xml version="1.0" encoding="UTF-8"?>
<!--
  MSI installer for the Praxis CLI (WiX v4+ schema).
  Build with scripts\build-msi.bat, or directly:
    wix build -arch x64 -d Version=X.Y.Z -d BuildDir=bin -o bin/praxis-cli_windows_installer.msi praxis-cli.wxs
  Version must be numeric (X.Y.Z); drop any -rc.N suffix.
  Requires bin/praxis-cli_windows_amd64.exe and third_party/wintun/amd64/wintun.dll.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Praxis CLI"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Fossorial"
           UpgradeCode="35A1E3C4-C273-4334-9DF3-57408E83012E"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="praxis-cli">
        <Component Id="PraxisCli" Guid="C1D2E3F4-A5B6-4789-9012-3456789ABCDE">
          <File Id="PraxisCliExe"
                Source="$(var.BuildDir)/praxis-cli_windows_amd64.exe"
                Name="pangolin.exe"
                KeyPath="yes" />
          <Environment Id="PraxisCliPath"
                       Name="PATH"
                       Value="[INSTALLFOLDER]"
                       Part="last"
                       Action="set"
                       System="yes" />
        </Component>
        <Component Id="WintunDll" Guid="E3F4A5B6-C7D8-4901-1234-56789ABCDEF0">
          <File Id="WintunDll"
                Source="third_party/wintun/amd64/wintun.dll"
                Name="wintun.dll"
                KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="praxis-cli">
        <Component Id="StartMenuShortcut" Guid="D2E3F4A5-B6C7-4890-0123-456789ABCDEF">
          <Shortcut Id="StartMenuShortcut"
                    Name="praxis-cli"
                    Description="Praxis CLI"
                    Target="[INSTALLFOLDER]pangolin.exe"
                    Icon="ProductIcon" />
          <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\Fossorial\PraxisCLI"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="ProductFeature" Title="praxis-cli" Level="1">
      <ComponentRef Id="PraxisCli" />
      <ComponentRef Id="WintunDll" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Icon Id="ProductIcon" SourceFile="icons/icon-orange.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
  </Package>
</Wix>
